#let extension-rows(
  a,
  b,
  c,
  d,
  left-map,
  middle-map,
  right-map,
  top-left: $i$,
  top-right: $phi$,
  bottom-left: $i'$,
  dashed: false,
  endpoints: $0$,
) = graph(
  (
    ((0, 0), endpoints),
    ((1, 0), a),
    ((2, 0), b),
    ((3, 0), c),
    ((4, 0), endpoints),
    ((0, 1), endpoints),
    ((1, 1), d.at(0)),
    ((2, 1), d.at(1)),
    ((3, 1), d.at(2)),
    ((4, 1), endpoints),
  ),
  (
    ((0, 0), (1, 0), [], left),
    ((1, 0), (2, 0), top-left, left),
    ((2, 0), (3, 0), top-right, left),
    ((3, 0), (4, 0), [], left),
    ((0, 1), (1, 1), [], left),
    ((1, 1), (2, 1), bottom-left, right),
    ((2, 1), (3, 1), [], right),
    ((3, 1), (4, 1), [], right),
    ((1, 0), (1, 1), left-map, right),
    ((2, 0), (2, 1), middle-map, right, if dashed { "--|>" } else { "-|>" }),
    ((3, 0), (3, 1), right-map, right),
  ),
  spacing: (14mm, 11mm),
)

