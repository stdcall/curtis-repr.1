    edge((3, 0), (4, 0), "-|>"),
    edge((0, 1), (1, 1), "-|>"),
    edge((1, 1), (2, 1), "-|>"),
    edge((2, 1), (3, 1), $mu_1$, "-|>", label-side: left),
    edge((3, 1), (4, 1), "-|>"),
